# ============ 依赖 ============
node_modules

# ============ 构建产物（均由构建重新生成，不入库） ============
dist
dist-ssr
.vite
*.local
target
src-tauri/target
src-tauri/bundle
# Tauri 打包时下载的 WiX 工具链；gen/schemas 由 src-tauri/.gitignore 负责
src-tauri/WixTools

# ============ 日志 ============
*.log
npm-debug.log*

# ============ 临时 / 备份文件 ============
*.tmp
*.temp
*.bak
*~

# ============ 环境变量（.env.example 是模板，必须入库） ============
.env
.env.*
!.env.example

# ============ 本地应用数据（含账号与凭据，禁止入库） ============
accounts.txt
*.db
*.sqlite

# ============ Python 辅助脚本产物（check_quota.py 等） ============
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ============ 编辑器 / IDE / 系统 ============
.vscode/*
!.vscode/extensions.json
.idea
.claude/
.trae/
.DS_Store
Thumbs.db
*.sw?
